<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="10dp">

        <TextView style="@style/PageTitle" android:text="Panes Unlock" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="多应用 Hook 解锁模块"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <!-- 状态卡 -->
        <LinearLayout style="@style/Card"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/ok_green"
                xmlns:app="http://schemas.android.com/apk/res-auto" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView android:id="@+id/home_status" style="@style/CardTitle" android:text="已激活" />
                <TextView android:id="@+id/home_version" style="@style/CardSub" android:text="" />
            </LinearLayout>
        </LinearLayout>

        <!-- 统计两卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <LinearLayout style="@style/Card"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="0dp"
                android:orientation="vertical">
                <TextView android:id="@+id/home_stat_apps" style="@style/CardTitle" android:text="0" />
                <TextView style="@style/CardSub" android:text="适配应用" />
            </LinearLayout>
            <LinearLayout style="@style/Card"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="0dp"
                android:orientation="vertical">
                <TextView android:id="@+id/home_stat_ext" style="@style/CardTitle" android:text="0" />
                <TextView style="@style/CardSub" android:text="拓展" />
            </LinearLayout>
        </LinearLayout>

        <!-- 信息卡 -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <TextView style="@style/CardTitle" android:text="版本" />
            <TextView android:id="@+id/home_build" style="@style/CardSub" android:text="" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/bg_card_stroke" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />
            <TextView style="@style/CardTitle" android:text="安卓版本" />
            <TextView android:id="@+id/home_android" style="@style/CardSub" android:text="" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/bg_card_stroke" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />
            <TextView style="@style/CardTitle" android:text="设备型号" />
            <TextView android:id="@+id/home_device" style="@style/CardSub" android:text="" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/bg_card_stroke" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />
            <TextView style="@style/CardTitle" android:text="系统架构" />
            <TextView android:id="@+id/home_arch" style="@style/CardSub" android:text="" />
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="@color/bg_card_stroke" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />
            <TextView style="@style/CardTitle" android:text="框架 &amp; API" />
            <TextView style="@style/CardSub" android:text="LSPosed（Xposed API 82）" />
        </LinearLayout>

        <!-- 反馈卡 -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <TextView style="@style/CardTitle" android:text="遇到问题？" />
            <TextView android:id="@+id/home_github" style="@style/CardSub"
                android:text="在 GitHub 反馈"
                android:textColor="@color/accent"
                android:paddingTop="6dp" />
            <TextView
                style="@style/CardSub"
                android:text="新增目标应用后，请在 LSPosed 勾选该应用作用域并重启生效"
                android:paddingTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
