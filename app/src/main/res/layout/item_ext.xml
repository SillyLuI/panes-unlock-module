<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ext_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card2"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- 左半部分：点击进入「配置：xxx」 -->
    <LinearLayout
        android:id="@+id/ext_item_open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/ext_item_icon"
            android:layout_width="46dp"
            android:layout_height="46dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/ext_item_title"
                style="@style/CardTitle"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/ext_item_pkg"
                style="@style/CardSub"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/ext_item_version"
                style="@style/CardSub"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右半部分：勾选框 = 启用/停用 -->
    <CheckBox
        android:id="@+id/ext_item_check"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:button="@null"
        android:background="@drawable/check_box"
        android:gravity="center" />
</LinearLayout>
