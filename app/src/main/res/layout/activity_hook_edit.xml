<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/he_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_back"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Hook 配置"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/he_more"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:src="@drawable/ic_more"
                android:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- 总开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/SwitchText" android:text="总开关" />
                <TextView
                    android:id="@+id/he_pkg"
                    style="@style/SwitchSub" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/he_master"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp"
            android:paddingBottom="10dp"
            android:text="启用后，模块才会执行自定义 Hook。"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/he_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="140dp"
            android:overScrollMode="never" />
    </LinearLayout>

    <!-- 右下角：导入 / 新建 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/he_import"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_chip_btn"
            android:drawableStart="@drawable/ic_clipboard"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="导入"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:elevation="6dp" />

        <TextView
            android:id="@+id/he_new"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip_btn"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="新建"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:elevation="6dp" />
    </LinearLayout>
</FrameLayout>
